# supervisor.html

```html
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Supervisor</title>
</head>
<body>

<h1>Painel Supervisor</h1>

<button onclick="baixarCSV()">Exportar CSV</button>

<table border="1" cellpadding="10">
<thead>
<tr>
<th>Matrícula</th>
<th>Nome</th>
<th>Status</th>
</tr>
</thead>
<tbody id="tbody"></tbody>
</table>

<script>
const API = 'http://127.0.0.1:8000';

const usuario = prompt('Usuário supervisor');
const senha = prompt('Senha supervisor');

const auth = btoa(`${usuario}:${senha}`);

async function carregar(){

  const res = await fetch(`${API}/api/supervisor/hoje`,{
    headers:{
      Authorization:`Basic ${auth}`
    }
  });

  const data = await res.json();

  const tbody = document.getElementById('tbody');

  tbody.innerHTML = '';

  data.forEach(item=>{

    tbody.innerHTML += `
      <tr>
        <td>${item.matricula}</td>
        <td>${item.nome}</td>
        <td>${item.status}</td>
      </tr>
    `;
  });
}

function baixarCSV(){
  window.open(`${API}/api/supervisor/csv`, '_blank');
}

carregar();
</script>

</body>
</html>
