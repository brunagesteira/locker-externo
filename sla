```html
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registro de Ponto</title>

<style>
body{
  font-family:Arial;
  background:#f5f5f5;
  display:flex;
  justify-content:center;
  align-items:center;
  min-height:100vh;
}

.card{
  background:white;
  width:350px;
  padding:25px;
  border-radius:12px;
  box-shadow:0 0 10px rgba(0,0,0,0.1);
}

input{
  width:100%;
  padding:12px;
  margin-top:5px;
  margin-bottom:15px;
}

button{
  width:100%;
  padding:12px;
  border:none;
  border-radius:8px;
  cursor:pointer;
  margin-top:10px;
}

.btn-dark{
  background:black;
  color:white;
}

.btn-pause{
  background:orange;
}

.btn-end{
  background:#ffcccc;
}

.screen{
  display:none;
}

.screen.active{
  display:block;
}
</style>
</head>
<body>

<div id="screen-login" class="screen active">
  <div class="card">

    <h2>Registro de Ponto</h2>

    <label>Matrícula</label>
    <input type="text" id="inp-matricula">

    <label>Nome</label>
    <input type="text" id="inp-nome">

    <button class="btn-dark" onclick="fazerLogin()">Entrar</button>

    <button onclick="window.location.href='supervisor.html'">
      Supervisor
    </button>

    <p id="erro" style="color:red"></p>

  </div>
</div>

<div id="screen-dashboard" class="screen">

  <div class="card">

    <h2 id="dash-nome"></h2>
    <p id="dash-matricula"></p>

    <h3>Tempo Logado</h3>
    <h1 id="t-logado">00:00:00</h1>

    <h3>Tempo Pausa</h3>
    <h1 id="t-pausa">00:00:00</h1>

    <button id="btn-pausa" class="btn-pause" onclick="togglePausa()">
      Iniciar pausa
    </button>

    <button class="btn-end" onclick="encerrarJornada()">
      Encerrar jornada
    </button>

  </div>

</div>

<script>
const API = "http://127.0.0.1:8000";

let state = {
  matricula:null,
  nome:null,
  sessaoId:null,
  logadoSeg:0,
  pausaSeg:0,
  emPausa:false,
  ticker:null
};

function fmt(seg){
  const h = String(Math.floor(seg/3600)).padStart(2,'0');
  const m = String(Math.floor((seg%3600)/60)).padStart(2,'0');
  const s = String(seg%60).padStart(2,'0');

  return `${h}:${m}:${s}`;
}

function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

async function fazerLogin(){

  const matricula = document.getElementById('inp-matricula').value;
  const nome = document.getElementById('inp-nome').value;

  try{

    const res = await fetch(`${API}/api/login`,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        matricula,
        nome
      })
    });

    const data = await res.json();

    state.matricula = matricula;
    state.nome = nome;
    state.sessaoId = data.sessao_id;

    localStorage.setItem('ponto_session', JSON.stringify(state));

    document.getElementById('dash-nome').textContent = nome;
    document.getElementById('dash-matricula').textContent = matricula;

    showScreen('screen-dashboard');

    iniciarTimer();

  }catch(e){
    document.getElementById('erro').textContent = 'Erro ao conectar servidor';
  }
}

function iniciarTimer(){

  state.ticker = setInterval(()=>{

    state.logadoSeg++;

    if(state.emPausa){
      state.pausaSeg++;
    }

    document.getElementById('t-logado').textContent = fmt(state.logadoSeg);
    document.getElementById('t-pausa').textContent = fmt(state.pausaSeg);

  },1000);
}

async function togglePausa(){

  state.emPausa = !state.emPausa;

  const btn = document.getElementById('btn-pausa');

  if(state.emPausa){
    btn.innerText = 'Terminar pausa';
  }else{
    btn.innerText = 'Iniciar pausa';
  }

  await fetch(`${API}/api/evento`,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      matricula:state.matricula,
      sessao_id:state.sessaoId,
      tipo:state.emPausa ? 'PAUSA_INICIO' : 'PAUSA_FIM'
    })
  });
}

async function encerrarJornada(){

  clearInterval(state.ticker);

  await fetch(`${API}/api/logout`,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      matricula:state.matricula,
      sessao_id:state.sessaoId,
      total_logado_seg:state.logadoSeg,
      total_pausa_seg:state.pausaSeg
    })
  });

  localStorage.removeItem('ponto_session');

  location.reload();
}

function restaurarSessao(){

  const salva = localStorage.getItem('ponto_session');

  if(!salva) return;

  const dados = JSON.parse(salva);

  state = dados;

  document.getElementById('dash-nome').textContent = state.nome;
  document.getElementById('dash-matricula').textContent = state.matricula;

  showScreen('screen-dashboard');

  iniciarTimer();
}

restaurarSessao();
</script>

</body>
</html>
